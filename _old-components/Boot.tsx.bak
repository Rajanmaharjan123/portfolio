"use client";
import { useEffect, useState } from "react";

const LINES = [
  ["Initializing Xcode toolchain", "OK"],
  ["Linking UIKit.framework / SwiftUI.framework", "OK"],
  ["Calibrating LiDAR sensor", "OK"],
  ["Loading RealityKit ObjectCaptureSession", "OK"],
  ["Rolling Langur Burja dice ⚀ ⚃ ⚅", "OK"],
  ["Syncing MQTT broker", "OK"],
  ["Spawning player: RAJAN_M", "READY"],
];

export default function Boot() {
  const [shown, setShown] = useState(0);
  const [pct, setPct] = useState(0);
  const [done, setDone] = useState(false);
  const [gone, setGone] = useState(false);

  useEffect(() => {
    try {
      if (sessionStorage.getItem("booted")) { setGone(true); return; }
    } catch {}
    const t = setInterval(() => {
      setPct((p) => {
        const n = Math.min(100, p + 3 + Math.random() * 6);
        setShown(Math.ceil((n / 100) * LINES.length));
        if (n >= 100) { clearInterval(t); setDone(true); }
        return n;
      });
    }, 70);
    return () => clearInterval(t);
  }, []);

  const start = () => {
    try { sessionStorage.setItem("booted", "1"); } catch {}
    setGone(true);
  };

  useEffect(() => {
    if (!done || gone) return;
    const k = (e: KeyboardEvent) => { if (e.key === "Enter" || e.key === " ") start(); };
    window.addEventListener("keydown", k);
    return () => window.removeEventListener("keydown", k);
  }, [done, gone]);

  return (
    <div className={`boot ${gone ? "hide" : ""}`} aria-hidden={gone}>
      <div className="boot-inner">
        <p style={{ color: "var(--cyan)", letterSpacing: ".3em", marginBottom: 18 }}>RM-OS v6.0 // SPATIAL BUILD</p>
        <div className="boot-log">
          {LINES.slice(0, shown).map(([l, s]) => (
            <p key={l}>&gt; {l} <span className="dim">........</span> <b>{s}</b></p>
          ))}
        </div>
        <div className="boot-bar"><i style={{ width: `${pct}%` }} /></div>
        <div className="boot-meta"><span>LOADING ASSETS</span><span>{Math.floor(pct)}%</span></div>
        <div className="boot-start">
          {done ? (
            <button className="btn btn-primary" onClick={start} autoFocus>
              <span className="blink">▶</span> Press Start <span className="kbd">ENTER</span>
            </button>
          ) : (
            <button className="btn btn-ghost" onClick={start}>Skip intro</button>
          )}
        </div>
      </div>
    </div>
  );
}
