"use client";

import { Canvas, useFrame, useThree } from "@react-three/fiber";
import { Edges, Float, Grid, RoundedBox, Sparkles, Stars } from "@react-three/drei";
import { useEffect, useMemo, useRef, useState } from "react";
import * as THREE from "three";

/* Animated "LiDAR scan" shader for the phone screen */
const screenVert = /* glsl */ `
  varying vec2 vUv;
  void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }
`;
const screenFrag = /* glsl */ `
  uniform float uTime;
  varying vec2 vUv;
  float grid(vec2 uv, float n){ vec2 g = abs(fract(uv*n)-0.5); return smoothstep(0.47,0.5,max(g.x,g.y)); }
  void main(){
    vec2 uv = vUv;
    vec3 base = vec3(0.01,0.03,0.07);
    float g = grid(uv*vec2(1.0,2.1), 9.0) * 0.35;
    float scan = fract(uTime*0.25);
    float band = smoothstep(0.08,0.0,abs(uv.y-scan));
    float trail = smoothstep(scan, scan-0.35, uv.y) * step(uv.y, scan);
    vec3 cyan = vec3(0.1,0.95,1.0);
    vec3 mag = vec3(1.0,0.2,0.75);
    vec2 r = abs(uv-vec2(0.5,0.48));
    float room = smoothstep(0.012,0.0,abs(max(r.x*1.25,r.y*0.95)-0.22));
    float diag = smoothstep(0.01,0.0,abs(r.x*1.25-r.y*0.95)) * step(max(r.x*1.25,r.y*0.95),0.22);
    vec3 col = base + cyan*g*(0.3+trail) + cyan*band*0.9 + mag*(room+diag*0.6)*trail*1.4;
    float vign = smoothstep(0.75,0.2,length(uv-0.5));
    gl_FragColor = vec4(col*vign + base, 1.0);
  }
`;

function Phone() {
  const mat = useMemo(
    () => new THREE.ShaderMaterial({ uniforms: { uTime: { value: 0 } }, vertexShader: screenVert, fragmentShader: screenFrag }),
    []
  );
  const group = useRef<THREE.Group>(null);
  useFrame((s) => {
    mat.uniforms.uTime.value = s.clock.elapsedTime;
    if (group.current) group.current.rotation.y = Math.sin(s.clock.elapsedTime * 0.4) * 0.35 - 0.25;
  });
  return (
    <Float speed={1.4} rotationIntensity={0.25} floatIntensity={0.8}>
      <group ref={group} rotation={[0.08, -0.25, 0.04]}>
        <RoundedBox args={[1.5, 3.05, 0.16]} radius={0.2} smoothness={6}>
          <meshStandardMaterial color="#0b0f1d" metalness={0.9} roughness={0.25} />
          <Edges color="#22e6ff" threshold={20} />
        </RoundedBox>
        <mesh position={[0, 0, 0.085]} material={mat}>
          <planeGeometry args={[1.36, 2.9]} />
        </mesh>
        <mesh position={[0, 1.3, 0.09]}>
          <capsuleGeometry args={[0.055, 0.22, 4, 12]} />
          <meshBasicMaterial color="#000" />
        </mesh>
        <RoundedBox args={[0.6, 0.6, 0.06]} radius={0.12} position={[-0.38, 1.1, -0.1]}>
          <meshStandardMaterial color="#111827" metalness={1} roughness={0.2} />
          <Edges color="#ff3cc7" />
        </RoundedBox>
      </group>
    </Float>
  );
}

/* Langur Burja (Jhandi Munda) dice orbiting the phone */
function Die({ radius, speed, offset, color, size = 0.42, y = 0 }: {
  radius: number; speed: number; offset: number; color: string; size?: number; y?: number;
}) {
  const ref = useRef<THREE.Mesh>(null);
  useFrame((s, d) => {
    const t = s.clock.elapsedTime * speed + offset;
    if (!ref.current) return;
    ref.current.position.set(Math.cos(t) * radius, y + Math.sin(t * 1.7) * 0.35, Math.sin(t) * radius * 0.6);
    ref.current.rotation.x += d * 0.7;
    ref.current.rotation.y += d * 1.0;
  });
  return (
    <mesh ref={ref}>
      <boxGeometry args={[size, size, size]} />
      <meshStandardMaterial color="#0a0d18" emissive={color} emissiveIntensity={0.15} metalness={0.6} roughness={0.3} />
      <Edges color={color} />
    </mesh>
  );
}

function WireOrb({ position, color, scale = 1 }: { position: [number, number, number]; color: string; scale?: number }) {
  const ref = useRef<THREE.Mesh>(null);
  useFrame((_, d) => {
    if (ref.current) { ref.current.rotation.x += d * 0.15; ref.current.rotation.y += d * 0.22; }
  });
  return (
    <mesh ref={ref} position={position} scale={scale}>
      <icosahedronGeometry args={[1, 1]} />
      <meshBasicMaterial color={color} wireframe transparent opacity={0.3} />
    </mesh>
  );
}

/* Keeps the phone clear of the headline: right side on wide screens, small and high on phones */
function Stage({ children }: { children: React.ReactNode }) {
  const { size } = useThree();
  const aspect = size.width / size.height;
  const mobile = aspect < 0.85;
  const x = mobile ? 0.75 : Math.min(3.6, 1.5 + aspect * 0.95);
  return (
    <group position={[x, mobile ? 2.2 : 0.1, mobile ? -2.4 : 0]} scale={mobile ? 0.5 : 1}>
      {children}
    </group>
  );
}

function Rig() {
  const { camera, pointer } = useThree();
  const target = useMemo(() => new THREE.Vector3(), []);
  useFrame(() => {
    target.set(pointer.x * 0.9, 0.3 + pointer.y * 0.5, 7);
    camera.position.lerp(target, 0.04);
    camera.lookAt(0, 0, 0);
  });
  return null;
}

export default function HeroScene() {
  const wrap = useRef<HTMLDivElement>(null);
  const [visible, setVisible] = useState(true);
  const [small, setSmall] = useState(false);
  const [still, setStill] = useState(false);

  useEffect(() => {
    setSmall(window.innerWidth < 760);
    setStill(window.matchMedia("(prefers-reduced-motion: reduce)").matches);
    const el = wrap.current;
    if (!el) return;
    // Stop rendering when the hero is off screen — saves battery and keeps scrolling smooth
    const io = new IntersectionObserver(([e]) => setVisible(e.isIntersecting), { threshold: 0 });
    io.observe(el);
    const vis = () => setVisible(!document.hidden);
    document.addEventListener("visibilitychange", vis);
    return () => { io.disconnect(); document.removeEventListener("visibilitychange", vis); };
  }, []);

  return (
    <div ref={wrap} style={{ position: "absolute", inset: 0 }}>
      <Canvas
        dpr={small ? [1, 1.5] : [1, 1.75]}
        frameloop={visible && !still ? "always" : "demand"}
        camera={{ position: [0, 0.3, 7], fov: 45 }}
        gl={{ antialias: !small, alpha: true, powerPreference: "high-performance" }}
        style={{ position: "absolute", inset: 0 }}
      >
        <color attach="background" args={["#05060d"]} />
        <fog attach="fog" args={["#05060d", 8, 22]} />
        <ambientLight intensity={0.35} />
        <pointLight position={[3, 3, 4]} intensity={40} color="#22e6ff" />
        <pointLight position={[-4, -1, 2]} intensity={30} color="#ff3cc7" />

        <Stage>
          <Phone />
          <Die radius={2.1} speed={0.5} offset={0} color="#22e6ff" />
          <Die radius={2.4} speed={0.42} offset={2.1} color="#ff3cc7" size={0.36} y={0.4} />
          <Die radius={1.9} speed={0.6} offset={4.2} color="#b6ff3c" size={0.32} y={-0.5} />
          <Die radius={2.7} speed={0.35} offset={1.1} color="#ffb83c" size={0.3} y={0.9} />
        </Stage>

        <WireOrb position={[-4.5, 2.2, -4]} color="#22e6ff" scale={1.2} />
        <WireOrb position={[5.5, -2, -6]} color="#ff3cc7" scale={1.6} />

        <Grid
          position={[0, -2.2, 0]}
          args={[40, 40]}
          cellSize={0.6}
          cellThickness={0.6}
          cellColor="#123447"
          sectionSize={3}
          sectionThickness={1.2}
          sectionColor="#22e6ff"
          fadeDistance={22}
          fadeStrength={1.5}
          infiniteGrid
        />
        <Stars radius={60} depth={30} count={small ? 1000 : 2500} factor={3} fade speed={0.6} />
        <Sparkles count={small ? 25 : 60} scale={[12, 6, 6]} size={2} speed={0.3} color="#22e6ff" />
        <Rig />
      </Canvas>
    </div>
  );
}
