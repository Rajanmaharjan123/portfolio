import type { Item, ServiceIcon as SI } from "@/lib/data";

const s = { fill: "none", stroke: "currentColor", strokeWidth: 1.6, strokeLinecap: "round", strokeLinejoin: "round" } as const;

export function ItemIcon({ name }: { name: Item["icon"] }) {
  switch (name) {
    case "dice":
      return <svg viewBox="0 0 24 24" {...s}><path d="M12 2 21 7v10l-9 5-9-5V7z" /><path d="M3 7l9 5 9-5M12 12v10" /><circle cx="12" cy="7" r=".8" fill="currentColor" /><circle cx="7.5" cy="13" r=".8" fill="currentColor" /><circle cx="16.5" cy="13" r=".8" fill="currentColor" /><circle cx="16.5" cy="17" r=".8" fill="currentColor" /></svg>;
    case "cube":
      return <svg viewBox="0 0 24 24" {...s}><path d="M12 3 20 7.5v9L12 21l-8-4.5v-9z" /><path d="M4 7.5 12 12l8-4.5M12 12v9" strokeDasharray="2 2" /><path d="M2 4V2h2M22 4V2h-2M2 20v2h2M22 20v2h-2" /></svg>;
    case "scan":
      return <svg viewBox="0 0 24 24" {...s}><path d="M3 8V3h5M21 8V3h-5M3 16v5h5M21 16v5h-5" /><path d="M7 7h10v10H7z" /><path d="M3 12h18" /></svg>;
    case "car":
      return <svg viewBox="0 0 24 24" {...s}><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>;
    case "shield":
      return <svg viewBox="0 0 24 24" {...s}><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z" /><path d="M9 12l2 2 4-4" /></svg>;
    case "chat":
      return <svg viewBox="0 0 24 24" {...s}><path d="M4 4h16v12H8l-4 4z" /><path d="M8 9h8M8 12h5" /></svg>;
    case "film":
      return <svg viewBox="0 0 24 24" {...s}><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M10 9l5 3-5 3z" /><path d="M3 8h2M3 16h2M19 8h2M19 16h2" /></svg>;
    case "lock":
      return <svg viewBox="0 0 24 24" {...s}><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /><circle cx="12" cy="15.5" r="1.5" /></svg>;
    case "wallet":
      return <svg viewBox="0 0 24 24" {...s}><rect x="3" y="6" width="18" height="14" rx="2" /><path d="M3 10h18M16 15h2" /><path d="M6 6l9-3 1 3" /></svg>;
    case "store":
      return <svg viewBox="0 0 24 24" {...s}><path d="M4 9l1.5-5h13L20 9" /><path d="M4 9h16v2a3 3 0 0 1-5.3 2 3 3 0 0 1-5.4 0A3 3 0 0 1 4 11z" /><path d="M5 13v8h14v-8M10 21v-5h4v5" /></svg>;
    case "plane":
      return <svg viewBox="0 0 24 24" {...s}><path d="M2 16l20-8-3-2-7 3-6-4-2 1 4 5-4 2-2-1-1 1 3 3z" /><path d="M3 21h18" /></svg>;
  }
}

export function ServiceGlyph({ name }: { name: SI }) {
  switch (name) {
    case "phone":
      return <svg viewBox="0 0 24 24" {...s}><rect x="6" y="2" width="12" height="20" rx="3" /><path d="M10 5h4M11 19h2" /></svg>;
    case "ar":
      return <svg viewBox="0 0 24 24" {...s}><path d="M3 7V3h4M21 7V3h-4M3 17v4h4M21 17v4h-4" /><path d="M12 6l5 3v6l-5 3-5-3V9z" /><path d="M7 9l5 3 5-3M12 12v6" /></svg>;
    case "sdk":
      return <svg viewBox="0 0 24 24" {...s}><path d="M8 4 3 12l5 8M16 4l5 8-5 8" /><path d="M14 4l-4 16" /></svg>;
    case "rescue":
      return <svg viewBox="0 0 24 24" {...s}><path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 3v6h-6" /><path d="M9 12l2 2 4-4" /></svg>;
    case "cross":
      return <svg viewBox="0 0 24 24" {...s}><rect x="2" y="5" width="9" height="15" rx="2" /><rect x="13" y="3" width="9" height="15" rx="2" /><path d="M6 17h1M17 15h1" /></svg>;
    case "chip":
      return <svg viewBox="0 0 24 24" {...s}><rect x="6" y="6" width="12" height="12" rx="2" /><path d="M10 10h4v4h-4zM9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" /></svg>;
  }
}

export function TrophyIcon() {
  return <svg viewBox="0 0 24 24" {...s}><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z" /><path d="M7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4" /></svg>;
}

export function MailIcon() {
  return <svg viewBox="0 0 24 24" {...s}><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>;
}

export function DownloadIcon() {
  return <svg viewBox="0 0 24 24" {...s}><path d="M12 3v12M7 10l5 5 5-5M4 21h16" /></svg>;
}

export function ArrowIcon() {
  return <svg viewBox="0 0 24 24" {...s}><path d="M5 12h14M13 6l6 6-6 6" /></svg>;
}
