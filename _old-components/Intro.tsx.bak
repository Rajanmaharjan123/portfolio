"use client";
import { useEffect, useState } from "react";

/* A short, non-blocking boot flash. Auto-dismisses; never asks the visitor to press anything. */
const LINES = ["Linking SwiftUI.framework", "Calibrating LiDAR", "Loading RealityKit", "Spawning RAJAN_M"];

export default function Intro() {
  const [state, setState] = useState<"on" | "fade" | "off">("on");

  useEffect(() => {
    let seen = false;
    try { seen = !!sessionStorage.getItem("intro"); sessionStorage.setItem("intro", "1"); } catch {}
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (seen || reduce) { setState("off"); return; }
    const a = setTimeout(() => setState("fade"), 1100);
    const b = setTimeout(() => setState("off"), 1600);
    return () => { clearTimeout(a); clearTimeout(b); };
  }, []);

  if (state === "off") return null;
  return (
    <div className={`intro ${state === "fade" ? "fade" : ""}`} onClick={() => setState("off")} aria-hidden>
      <div className="intro-inner">
        <div className="intro-logo">RM</div>
        <div className="intro-log">
          {LINES.map((l, i) => (
            <p key={l} style={{ animationDelay: `${i * 180}ms` }}>&gt; {l} <b>OK</b></p>
          ))}
        </div>
        <div className="intro-bar"><i /></div>
      </div>
    </div>
  );
}
